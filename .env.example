# Set this to enable Postgres + Drizzle migration flow.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/writersfund
JWT_SECRET=your-jwt-secret

# reCAPTCHA v3 keys (get from https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Cron job authentication (generate a random secret)
CRON_SECRET=your-cron-secret

# Optional: Skip reCAPTCHA in development
# SKIP_RECAPTCHA=true
